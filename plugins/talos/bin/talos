#!/usr/bin/env python3
"""talos: Talos, the pubky team's agent, from your terminal or your coding agent.

  talos                      list every verb by tier      talos <verb> --help   usage and flags
  talos login                                             log in with your GitHub account (device prompt)
  talos login <token> [--url https://...]                 log in with a token instead (people outside the org)
  talos doctor                                            check config, desk, token, skill, MCP, version
  talos setup                                             register the skill and MCP server with every harness found
  talos setup --harness cursor                            one harness only, installed or not
  talos setup --print-mcp | --print-rules                 the MCP block and the sheet, for a harness you paste by hand
  talos mcp                                               stdio MCP server (what Claude Code and Codex run)

Global flags: --json (the desk's JSON on stdout), --yes (do it, for write verbs), --url, --quiet.
Environment: TALOS_TOKEN, TALOS_URL.

The desk URL comes from --url, then TALOS_URL, then the stored config, then the pointer file at
https://raw.githubusercontent.com/pubky/talos-cli/main/desk-url.txt. Moving the desk is one commit
to that file; `talos login` and `talos doctor` pick the new address up on their own.

## When something is broken

If a verb errors, returns wrong data, or Talos misbehaves, the fix is a pull request, not a workaround:
the client is the public repo `pubky/talos-cli` (the `talos` file, one Python file), the server and
Talos's skills are `pubky/talos-agent` (`skills/talos/talos-desk/scripts/talos-desk.py`, `skills/**`,
`AGENTS.md`), which every org member can push branches to. Clone it, fix it on a branch named
`<handle>/<what>`, open the PR with `gh pr create --fill`, and mention @SHAcollision in it; a desk
restart follows the merge. Prefer a short PR with the failing command and its output in the body over
an issue; file `talos issue pubky/talos-agent "..."` only when you cannot fix it yourself.

Exit codes: 0 ok, 1 error, 2 usage, 3 over budget, 4 not logged in or token revoked, 5 needs --yes,
6 not found, 7 refused by a Talos rule.
Single file, Python 3.8+, standard library only. Source: https://github.com/pubky/talos-cli
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VERSION = "0.3.1"
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "talos")
CONFIG = os.path.join(CONFIG_DIR, "config.json")
SKILL_PATHS = [os.path.expanduser("~/.claude/skills/talos/SKILL.md"),
               os.path.expanduser("~/.codex/skills/talos/SKILL.md")]

# Where the desk lives when nobody said. One line, one commit to move the whole team.
DEFAULT_URL = "https://talos-desk.pubky.app"   # the pointer file overrides this when the desk moves
