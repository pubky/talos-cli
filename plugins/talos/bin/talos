BY_CMD = dict((v["cmd"], v) for v in VERBS)
JOINED = ("query", "fact", "question", "task")
TIER_TITLE = {"read": "read     free, seconds, no model",
              "write": "write    changes something, needs --yes",
              "agent": "agent    a real Talos turn, budgeted"}
QUIET = False


def load_config():
    try:
        with open(CONFIG) as fh:
            return json.load(fh)
    except (IOError, OSError, ValueError):
        return {}


def save_config(c):
    if not os.path.isdir(CONFIG_DIR):
        os.makedirs(CONFIG_DIR, 0o700)
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)  # never readable, not even briefly
    with os.fdopen(fd, "w") as fh:
        json.dump(c, fh, indent=1)
    os.chmod(CONFIG, 0o600)


CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def clean(text):
    """What the desk sends is whatever someone wrote in Slack, in a PR title or in a doc, and it
    lands in a terminal: escape sequences there repaint the screen and hide lines."""
    return CONTROL.sub("?", str(text))


def die(msg, code=1, hint=""):
    sys.stderr.write("talos: %s%s\n" % (clean(msg), " (%s)" % clean(hint) if hint else ""))
    sys.exit(code)


def note(msg):
    if not QUIET:
        sys.stderr.write(clean(msg) + "\n")


def health(url):
    try:
        r = urllib.request.urlopen(url.rstrip("/") + "/health", timeout=15)
        return json.loads(r.read().decode("utf-8", "replace"))
    except Exception:
        return None


def pointer_url():
    """One line in the repo says where the desk is today, so an instruction never carries a URL."""
    try:
        raw = urllib.request.urlopen(POINTER_URL, timeout=15).read(500).decode("utf-8", "replace")
    except Exception:
        return DEFAULT_URL
    line = raw.strip().splitlines()[0].strip() if raw.strip() else ""
    if not line.startswith("http"):
        return DEFAULT_URL  # the file is broken, and the built-in address is the safe answer
    if not pointable(line):
        note("talos: the pointer file names %s, which is not an https desk; staying where you are" % line)
        return ""
    return line


def pointable(url):
    """One line in a public file moves the whole team, and their tokens go to wherever it says, so
    over the network it has to be https. Loopback is for whoever is testing a desk of their own."""
    host = url.split("//", 1)[-1].split("/")[0].split(":")[0]
    return url.startswith("https://") or (url.startswith("http://") and host in ("127.0.0.1", "localhost"))


def resolve_url(refresh=False):
    """--url and TALOS_URL win, then the stored one, then the pointer file. refresh re-reads the
    pointer when the stored desk stopped answering, so a desk that moved fixes itself."""
    env = os.environ.get("TALOS_URL")
    if env:
        return env.rstrip("/")
    c = load_config()
    url = (c.get("url") or "").rstrip("/")
    if url and (not refresh or health(url)):
        return url
    found = pointer_url().rstrip("/")
    if found and found != url and (not url or health(found)):
        c["url"] = found
        save_config(c)
        note("talos: the desk is at %s now (from the pointer file)" % found)
        return found
    return url


def endpoint():
    tok = os.environ.get("TALOS_TOKEN") or load_config().get("token")
    if not tok:
        die("not logged in", 4, "run `talos login` and complete the GitHub prompt it prints")
    url = resolve_url()
    if not url:
        die("no desk url, and the pointer file did not answer", 1, "talos login --url <desk url>")
    return url, tok


class Desk(Exception):
    def __init__(self, status, error, hint, code):
        Exception.__init__(self, error)
        self.status, self.error, self.hint, self.code = status, error, hint, code


def version_tuple(v):
    try:
        return tuple(int(x) for x in v.split("."))
    except (ValueError, AttributeError):
        return (0,)


def open_url(method, url, body=None, headers=None, timeout=120):
    h = {"Content-Type": "application/json", "User-Agent": "talos-cli/" + VERSION}
    h.update(headers or {})
    req = urllib.request.Request(url, data=json.dumps(body).encode() if body is not None else None, headers=h)
    req.get_method = lambda: method
    try:
        return urllib.request.urlopen(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read().decode("utf-8", "replace"))
        except ValueError:
            payload = {}
        raise Desk(e.code, payload.get("error") or str(e.reason), payload.get("hint", ""), payload.get("code", ""))
    except urllib.error.URLError as e:
        die("cannot reach the desk at %s: %s" % (url, e.reason), 1, "check it with `talos doctor`")


def request(method, path, body=None, stream=False, timeout=120):
    url, tok = endpoint()
    r = open_url(method, url + path, body, {"Authorization": "Bearer " + tok}, timeout)
    minv = r.headers.get("X-Talos-Min-Client")
    if minv and version_tuple(minv) > version_tuple(VERSION):
        note("talos: this client is %s, the desk wants %s; rerun install.sh" % (VERSION, minv))
    return r if stream else json.loads(r.read().decode("utf-8", "replace"))


def fail(ex, verb):
    if ex.status == 404 and ex.code in ("", "no_such_route", "no_such_verb"):
        die("the desk does not have %s yet, ask Chris to deploy v0.2" % verb, 6)
    die(ex.error, EXIT.get(ex.status, 1), ex.hint)


def call(verb, body, timeout=120):
    """POST /v/<verb>, falling back to the v0.1 route when the desk is still on v0.1."""
    try:
        return request("POST", "/v/" + verb, body, timeout=timeout)
    except Desk as ex:
        if ex.status == 404 and ex.code in ("", "no_such_route") and verb in LEGACY:
            try:
                out = request("POST", LEGACY[verb], body, timeout=timeout)
            except Desk as ex2:
                fail(ex2, verb)
            out["text"] = legacy_text(verb, out)
            return out
        fail(ex, verb)


def legacy_text(verb, out):
    """A v0.1 desk returns data with no rendering; do it here so the output still reads the same."""
    if verb == "review":
        return "%s: %s\n%s" % (out.get("status", ""), out.get("note", ""), out.get("url", ""))
    lines = []
    for source, hits in (out.get("results") or {}).items():
        if not hits:
            continue
        lines.append("== " + source)
        for h in hits:
            lines.append("%s  %s  %s" % (h.get("date") or h.get("when") or "", h.get("who", ""), h.get("where", "")))
            if h.get("snippet"):
                lines.append("    " + str(h["snippet"]).strip())
            if h.get("link"):
                lines.append("    " + h["link"])
    return "\n".join(lines) or "no hits"


# ---------- argument parsing ----------

GLOBAL_BOOLS = set(["json", "yes", "quiet", "help", "h"])


def opts(argv, bools):
    pos, kv, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            pos += argv[i + 1:]
            break
        if a.startswith("--"):
            k = a[2:]
            if "=" in k:
                k, v = k.split("=", 1)
                kv[k] = v
                i += 1
            elif k in bools or k in GLOBAL_BOOLS:
                kv[k] = True
                i += 1
            elif i + 1 < len(argv):
                kv[k] = argv[i + 1]
                i += 2
            else:
                die("--%s needs a value" % k, 2)
        else:
            pos.append(a)
            i += 1
    return pos, kv


def match_verb(argv):
    """`talos doc create x` and `talos find x` both land here; two-word commands win."""
    if len(argv) >= 2 and (argv[0] + " " + argv[1]) in BY_CMD:
        return BY_CMD[argv[0] + " " + argv[1]], argv[2:]
    if argv[0] in BY_CMD:
        return BY_CMD[argv[0]], argv[1:]
    return None, argv


def help_verb(v):
    out = [v["usage"], "", "%s. Use it %s." % (v["one"][0].upper() + v["one"][1:], v["when"]), "",
           "tier: " + v["tier"]]
    if v["tier"] == "write":
        out.append("this one changes something: without --yes it prints a preview and exits 5")
    out += ["", "example:", "  " + v["example"], "",
            "exit codes: 0 ok, 1 error, 2 usage, 3 over budget, 4 not logged in, 5 needs --yes,",
            "            6 not found, 7 refused by a Talos rule"]
    print("\n".join(out))


def usage_all():
    print("talos %s: Talos, the pubky team's agent, from your terminal.\n" % VERSION)
    for tier in ("read", "write", "agent"):
        print(TIER_TITLE[tier])
        for v in VERBS:
            if v["tier"] == tier:
                print("  %-18s %s" % (v["cmd"], v["one"]))
        print("")
    print("also: login, whoami, doctor, setup, skill, verbs, mcp, help <verb>")
    print("flags: --json --yes --quiet --url <desk>   env: TALOS_TOKEN TALOS_URL")


# ---------- the generic verb path ----------

def build_body(v, argv):
    bools = set(v.get("bools") or [])
    pos, kv = opts(argv, bools)
    if kv.get("help") or kv.get("h"):
        help_verb(v)
        sys.exit(0)
    body, names = {}, [p[0] for p in v["pos"]]
    joins = bool(names) and names[-1] in JOINED
    for i, (name, required, _) in enumerate(v["pos"]):
        if i < len(pos):
            body[name] = " ".join(pos[i:]) if (joins and i == len(names) - 1) else pos[i]
        elif required:
            die("usage: " + v["usage"], 2)
    if len(pos) > len(names) and not joins:
        die("usage: " + v["usage"], 2)
    for k in v["flags"]:
        if k in kv:
            body[k.replace("-", "_")] = kv[k]
    for k in bools:
        if kv.get(k):
            body[k] = True
    if kv.get("yes"):
        body["yes"] = True
    extra = [k for k in kv if k not in v["flags"] and k not in bools and k not in GLOBAL_BOOLS]
    if extra:
        die("%s does not take --%s" % (v["cmd"], ", --".join(sorted(extra))), 2, v["usage"])
    return body, kv


def cmd_verb(v, argv):
    body, kv = build_body(v, argv)
    if v["verb"] == "issue":
        body = issue_body(body)
    elif v["verb"] == "doc_create":
        body = doc_body(body, v)
    elif v["verb"] == "ask":
        return cmd_ask(body, kv)
    elif v["verb"] == "review" and not body.get("yes"):
        return review_preview(body, kv)
    timeout = 16 * 60 if body.get("wait") else 180
    render(call(v["verb"], body, timeout=timeout), kv)


def render(out, kv):
    if out.get("confirmed") is False:
        print(clean(out.get("preview", "")).rstrip())
        note("add --yes to do it")
        sys.exit(5)
    if kv.get("json"):
        print(json.dumps(out, indent=1))
    else:
        print(clean(out.get("text", "")).rstrip())


def read_source(path):
    if path in (None, "-"):
        if sys.stdin.isatty():
            die("nothing on stdin", 2, "pass a file, or pipe the markdown in")
        return sys.stdin.read()
    try:
        with open(os.path.expanduser(path)) as fh:
            return fh.read()
    except (IOError, OSError) as e:
        die("cannot read %s: %s" % (path, e.strerror), 2)


def issue_body(body):
    f = body.pop("body_file", None)
    if f:
        body["body"] = read_source(f)
    elif not body.get("body") and not sys.stdin.isatty():
        body["body"] = sys.stdin.read()
    return body


def doc_body(body, v):
    if not body.get("title"):
        die("usage: " + v["usage"], 2)
    body["md"] = read_source(body.get("md"))
    if not body["md"].strip():
        die("the document body is empty", 2, "pass --md <file> or pipe markdown in")
    return body


def review_preview(body, kv):
    """A v0.1 desk acts at once, so against one the preview has to happen here."""
    try:
        render(request("POST", "/v/review", body), kv)
    except Desk as ex:
        if ex.status == 404 and ex.code in ("", "no_such_route"):
            print("request a review from @talosmachina\n  %s" % body.get("pr", ""))
            note("add --yes to do it")
            sys.exit(5)
        fail(ex, "review")


# ---------- ask: streamed, so progress shows while Talos works ----------

def cmd_ask(body, kv):
    body["stream"] = True
    try:
        r = request("POST", "/v/ask", body, stream=True, timeout=20 * 60)
    except Desk as ex:
        if ex.status == 404 and ex.code in ("", "no_such_route"):
            body.pop("skill", None)
            r = request("POST", "/ask", body, stream=True, timeout=20 * 60)
        else:
            fail(ex, "ask")
    ev, final = None, None
    for raw in r:
        line = raw.decode("utf-8", "replace").rstrip("\n")
        if line.startswith("event:"):
            ev = line[6:].strip()
        elif line.startswith("data:") and ev:
            try:
                p = json.loads(line[5:].strip())
            except ValueError:
                continue
            if ev == "run.started":
                note("talos is on it (thread %s)" % p.get("thread"))
            elif ev == "tool.started":
                note("  " + str(p.get("tool")))  # note() strips control characters
            elif ev in ("run.completed", "run.failed"):
                final = (ev, p)
                break
    if not final:
        die("the desk closed the stream without an answer", 1, "try again")
    ev, p = final
    if ev == "run.failed":
        die(p.get("error", "the turn failed"), 1, p.get("hint", "try again, or ask in Slack"))
    if kv.get("json"):
        print(json.dumps(p, indent=1))
    else:
        print(clean(p.get("answer", "")).rstrip())
        sys.stdout.flush()
        note("\n(thread %s, %ss; follow up with --thread %s)" % (p.get("thread"), p.get("seconds"), p.get("thread")))


# ---------- login, whoami, doctor, setup ----------

def post_form(url, fields, timeout=30):
    data = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(url, data=data, headers={
        "Accept": "application/json", "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "talos-cli/" + VERSION})
    try:
        r = urllib.request.urlopen(req, timeout=timeout)
        raw = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
    except urllib.error.URLError as e:
        die("cannot reach GitHub at %s: %s" % (url, e.reason), 1, "check your network and try again")
    try:
        return json.loads(raw)
    except ValueError:
        die("GitHub answered something that is not JSON", 1, "try again, or use `talos login <token>`")


def device_login(url, as_json):
    """GitHub's device flow: the user opens a page and types a code, no secret on this machine."""
    try:
        cfg = json.loads(open_url("GET", url + "/login/config", timeout=20).read().decode("utf-8", "replace"))
    except Desk as ex:
        die(ex.error, EXIT.get(ex.status, 1), ex.hint or "use `talos login <token>` instead")
    start = post_form(GITHUB_OAUTH + "/login/device/code",
                      {"client_id": cfg["github_client_id"], "scope": "read:org"})
    if start.get("error") or not start.get("device_code"):
        die("GitHub refused to start the login: %s" % (start.get("error") or "no device code"),
            1, start.get("error_description") or "tell @SHAcollision; the desk's OAuth app may be wrong")
    line = "Open %s and enter code %s" % (start.get("verification_uri"), start.get("user_code"))
    sys.stderr.write(line + "\n")
    if not as_json:
        print(line)
        sys.stdout.flush()
    interval = int(start.get("interval") or 5)
    deadline = time.time() + int(start.get("expires_in") or 900)
    while time.time() < deadline:
        time.sleep(interval)
        r = post_form(GITHUB_OAUTH + "/login/oauth/access_token",
                      {"client_id": cfg["github_client_id"], "device_code": start["device_code"],
                       "grant_type": "urn:ietf:params:oauth:grant-type:device_code"})
        err = r.get("error")
        if not err and r.get("access_token"):
            return r["access_token"]
        if err == "authorization_pending":
            continue
        if err == "slow_down":
            interval = int(r.get("interval") or interval + 5)
            continue
        if err == "expired_token":
            die("the code expired before you entered it", 1, "run `talos login` again")
        if err == "access_denied":
            die("the login was cancelled on GitHub", 1, "run `talos login` again to retry")
        die("GitHub said %s" % (err or "nothing useful"), 1,
            r.get("error_description") or "run `talos login` again")
    die("the code expired before you entered it", 1, "run `talos login` again")


def cmd_login(argv):
    pos, kv = opts(argv, set())
    if kv.get("url"):
        os.environ["TALOS_URL"] = kv["url"]
    url = resolve_url(refresh=True)
    if not url:
        die("no desk url: the pointer file did not answer", 1, "talos login --url <desk url>")
    c = load_config()
    if pos:
        c["token"] = pos[0]
    else:
        c["token"] = post_login(url, device_login(url, bool(kv.get("json"))))["token"]
    c["url"] = url
    save_config(c)
    os.environ["TALOS_URL"], os.environ["TALOS_TOKEN"] = url, c["token"]
    try:
        me = request("GET", "/me")
    except Desk as ex:
        fail(ex, "login")
    print("logged in as @%s" % me["handle"])
    note("desk %s; %d asks left today" % (url, me["asks_per_day"] - me["asks_today"]))
    refresh_skill(quiet=True)


def post_login(url, github_token):
    try:
        out = json.loads(open_url("POST", url + "/login/github", {"access_token": github_token},
                                  timeout=60).read().decode("utf-8", "replace"))
    except Desk as ex:
        die(ex.error, EXIT.get(ex.status, 1), ex.hint)
    if out.get("note"):
        note(out["note"])
    return out


def cmd_whoami(argv):
    try:
        me = request("GET", "/me")
    except Desk as ex:
        fail(ex, "whoami")
    if "--json" in argv:
        print(json.dumps(me, indent=1))
        return
    line = "@%s: %d/%d asks today (resets %s), desk-wide %d/%d" % (
        me["handle"], me["asks_today"], me["asks_per_day"], me["resets_at"],
        me["asks_global_today"], me["asks_global_per_day"])
    if "writes_today" in me:
        line += "\n  writes %d/%d, delegates %d/%d%s" % (
            me["writes_today"], me["writes_per_day"], me["delegates_today"], me["delegates_per_day"],
            ", admin" if me.get("admin") else "")
    print(line)


def cmd_skill(argv):
    try:
        r = request("GET", "/skill", stream=True)
    except Desk as ex:
        fail(ex, "skill")
    print(clean(r.read(SHEET_MAX).decode("utf-8", "replace")).rstrip())


def cmd_verbs(argv):
    try:
        out = request("GET", "/verbs")
    except Desk as ex:
        fail(ex, "verbs")
    if "--json" in argv:
        print(json.dumps(out, indent=1))
        return
    for v in out["verbs"]:
        print(clean("%-16s %-6s %s" % (v["name"], v["tier"], v["usage"])))


FRONTMATTER = ('---\nname: talos\ndescription: "Talos is the pubky team\'s agent. Use it to search team history '
               '(Slack, Meet transcripts, Drive, GitHub, pubky.app), to read what the team wrote down, to ask what '
               'only Talos knows, to file issues and docs, and to request PR reviews. Trigger on: where did we '
               'discuss, did anyone report, who owns, what did the call conclude, who is out, ask Talos, get a '
               'review, file an issue."\n---\n\n')


SHEET_MAX = 64 * 1024
SHEET_HEAD = "# Talos from the terminal"


def known_sheet(body):
    """The sheet is installed where every harness reads it as instructions, so a desk that is not
    the desk cannot get a shell command or a payload past here: what the desk serves is headings,
    prose, and fenced blocks holding nothing but `talos` command lines."""
    if not body or len(body) > SHEET_MAX or not body.lstrip().startswith(SHEET_HEAD):
        return False
    fenced = False
    for line in body.splitlines():
        if line.startswith("```"):
            fenced = not fenced
        elif fenced and line.strip() and not line.startswith("talos "):
            return False
    return not fenced


def skill_text():
    """The desk serves the sheet; the copy embedded here is only a bootstrap."""
    try:
        body = request("GET", "/skill", stream=True, timeout=30).read(SHEET_MAX + 1).decode("utf-8", "replace")
    except (Desk, SystemExit, IOError, OSError):
        body = None
    if body is not None and not known_sheet(body):
        note("talos: the desk served a sheet this client does not recognise, keeping the built-in one")
        body = None
    return FRONTMATTER + clean(body or SKILL_MD), bool(body)


# ---------- the harnesses talos registers itself with ----------

MANAGED = "talos"
BLOCK_BEGIN = "<!-- talos:begin (managed by `talos setup`) -->"
BLOCK_END = "<!-- talos:end -->"

# Short on purpose: this goes into files the harness shares with everything else the user wrote,
# and Windsurf caps global rules at 6000 characters. The full sheet is one `talos skill` away.
RULES_BLOCK = """## Talos, the pubky team's agent

`talos` is installed on this machine. Reach for it for anything about this team: where something
was discussed, who reported what, who owns a repo, what a call concluded, who is out.

- `talos find "<words>"` first. It is free and instant, and it searches Slack, Meet transcripts,
  Drive, GitHub and pubky.app at once.
- `talos skills` lists what the team already wrote down, `talos skills <name>` prints one.
- `talos ask "<question>"` only when find and those skills cannot answer it.
- `talos review <pr-url>` after opening a PR in a pubky repo.
- Write verbs change something and do nothing without `--yes`. Read the preview first.
- `talos skill` prints the full sheet, `talos` lists every verb, `talos login` signs in.

Never paste secrets, tokens or private keys into an ask or a delegate."""


def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def opencode_config(d):
    """opencode reads either spelling; edit the one that is already there."""
    jsonc = os.path.join(d, "opencode.jsonc")
    return jsonc if os.path.isfile(jsonc) else os.path.join(d, "opencode.json")


def harnesses():
    """One row per coding harness: how to spot it, where its MCP registry lives, and where its copy
    of the sheet goes. Every path comes from that harness's own docs; see the table in README.md.
    claude and codex are always written, which is what they did before this table existed."""
    home = os.path.expanduser("~")
    windsurf = os.path.join(home, ".codeium", "windsurf")
    opencode = os.path.join(config_home(), "opencode")
    return [
        {"name": "claude", "bin": "claude", "dirs": [os.path.join(home, ".claude")], "always": True,
         "mcp": {"kind": "claude-cli"},
         "sheet": {"kind": "skill", "path": SKILL_PATHS[0]}},
        {"name": "codex", "bin": "codex", "dirs": [os.path.join(home, ".codex")], "always": True,
         "mcp": {"kind": "toml", "path": os.path.join(home, ".codex", "config.toml")},
         "sheet": {"kind": "skill", "path": SKILL_PATHS[1]}},
        {"name": "cursor", "bin": "cursor", "dirs": [os.path.join(home, ".cursor")],
         "mcp": {"kind": "json", "path": os.path.join(home, ".cursor", "mcp.json"), "key": "mcpServers"},
         "sheet": {"kind": "skill", "path": os.path.join(home, ".cursor", "skills", "talos", "SKILL.md")}},
        {"name": "windsurf", "bin": "windsurf", "dirs": [windsurf],
         "mcp": {"kind": "json", "path": os.path.join(windsurf, "mcp_config.json"), "key": "mcpServers"},
         "sheet": {"kind": "block", "path": os.path.join(windsurf, "memories", "global_rules.md")}},
        {"name": "gemini", "bin": "gemini", "dirs": [os.path.join(home, ".gemini")],
         "mcp": {"kind": "json", "path": os.path.join(home, ".gemini", "settings.json"), "key": "mcpServers"},
         "sheet": {"kind": "block", "path": os.path.join(home, ".gemini", "GEMINI.md")}},
        {"name": "opencode", "bin": "opencode", "dirs": [opencode, os.path.join(home, ".opencode")],
         "mcp": {"kind": "json", "path": opencode_config(opencode), "key": "mcp", "entry": "opencode"},
         "sheet": {"kind": "skill", "path": os.path.join(opencode, "skills", "talos", "SKILL.md")}},
    ]


def detected(row):
    if row.get("always") or shutil.which(row["bin"]):
        return True
    return any(os.path.isdir(d) for d in row["dirs"])


def live_harnesses():
    return [r for r in harnesses() if detected(r)]


def mcp_entry(mcp, me):
    if mcp.get("entry") == "opencode":
        return {"type": "local", "command": [me, "mcp"], "enabled": True}
    return {"command": me, "args": ["mcp"]}


def ensure_dir(path):
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d)


def write_file(path, text):
    ensure_dir(path)
    with open(path, "w") as fh:
        fh.write(text)


def backup_once(path):
    """One backup per file, ever, so a second setup cannot bury the pre-talos original."""
    bak = path + ".bak-talos"
    if os.path.isfile(path) and not os.path.exists(bak):
        shutil.copy2(path, bak)


def json_indent(text):
    """Rewrite the file the way its author indented it, so the diff is our key and nothing else."""
    for line in text.splitlines():
        body = line.lstrip()
        if body and body != line and body[0] in '"{[':
            lead = line[:len(line) - len(body)]
            return "\t" if lead[0] == "\t" else lead
    return "  "


def register_json(path, key, entry):
    text = open_or_empty(path)
    data = {}
    if text.strip():
        try:
            data = json.loads(text)
        except ValueError:
            data = None
        if not isinstance(data, dict):
            return "cannot parse %s; paste `talos setup --print-mcp` into it by hand" % path
    section = data.get(key)
    if not isinstance(section, dict):
        section = {}
    if section.get(MANAGED) == entry:
        return "already in " + path
    state = "updated in " if MANAGED in section else "added to "
    section[MANAGED] = entry
    data[key] = section
    backup_once(path)
    ensure_dir(path)
    with open(path, "w") as fh:
        json.dump(data, fh, indent=json_indent(text))
        fh.write("\n")
    return state + path


def register_toml(path, me):
    """Append only: a TOML file we did not write is not ours to reshape."""
    if "[mcp_servers.%s]" % MANAGED in open_or_empty(path):
        return "already in " + path
    backup_once(path)
    ensure_dir(path)
    with open(path, "a") as fh:
        fh.write('\n[mcp_servers.%s]\ncommand = "%s"\nargs = ["mcp"]\n' % (MANAGED, me))
    return "added to " + path


def register_claude_cli(me):
    if not shutil.which("claude"):
        return "claude is not installed, skipped"
    devnull = open(os.devnull, "w")
    rc = subprocess.call(["claude", "mcp", "add", "-s", "user", MANAGED, "--", me, "mcp"],
                         stdout=devnull, stderr=subprocess.STDOUT)
    devnull.close()
    return "registered" if rc == 0 else "already registered"


def register_block(path, block):
    """A marked block inside a file the user also writes in: replace ours, leave the rest alone."""
    text = open_or_empty(path)
    new = BLOCK_BEGIN + "\n" + block + "\n" + BLOCK_END
    if BLOCK_BEGIN in text and BLOCK_END in text:
        head, rest = text.split(BLOCK_BEGIN, 1)
        out = head + new + rest.split(BLOCK_END, 1)[1]
    else:
        out = (text.rstrip() + "\n\n" if text.strip() else "") + new + "\n"
    if out == text:
        return "already in " + path
    backup_once(path)
    write_file(path, out)
    return "written to " + path


def register_mcp(row, me):
    m = row["mcp"]
    if m["kind"] == "claude-cli":
        return register_claude_cli(me)
    if m["kind"] == "toml":
        return register_toml(m["path"], me)
    return register_json(m["path"], m["key"], mcp_entry(m, me))


def registered_in(row):
    """True, False, or None when only the harness itself could say and it would not."""
    m = row["mcp"]
    if m["kind"] == "claude-cli":
        if not shutil.which("claude"):
            return None
        p = None
        try:
            p = subprocess.Popen(["claude", "mcp", "list"], stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT)
            return MANAGED in p.communicate(timeout=30)[0].decode("utf-8", "replace")
        except Exception:
            if p:
                p.kill()
            return None
    if m["kind"] == "toml":
        return "[mcp_servers.%s]" % MANAGED in open_or_empty(m["path"])
    try:
        data = json.loads(open_or_empty(m["path"]) or "{}")
    except ValueError:
        return None
    section = data.get(m["key"]) if isinstance(data, dict) else None
    return MANAGED in section if isinstance(section, dict) else False


def say(name, what, detail):
    print("%-9s %-6s %s" % (name, what, detail))


def refresh_skill(rows=None, quiet=False):
    """Every harness gets the same sheet, as its own skill file or as a block in its rules file."""
    text, live = skill_text()
    for row in (live_harnesses() if rows is None else rows):
        sheet = row["sheet"]
        if sheet["kind"] == "skill":
            write_file(sheet["path"], text)
            detail = "%s (%s)" % (sheet["path"],
                                  "from the desk" if live else "embedded copy, the desk was not reachable")
        else:
            detail = register_block(sheet["path"], RULES_BLOCK)
        if not quiet:
            say(row["name"], "skill" if sheet["kind"] == "skill" else "rules", detail)
    return live


SETUP_FLAGS = ("harness", "print-mcp", "print-rules")
SETUP_USAGE = """talos setup [--harness <name>] [--print-mcp] [--print-rules]

Register the MCP server and the sheet with every coding harness on this machine. A harness counts
as present when its config directory or its binary is there; claude and codex are written either
way.

--harness <name>   write one harness, installed or not: %s
--print-mcp        print the MCP block, for a harness talos does not write to
--print-rules      print the sheet, to paste where that harness keeps its rules"""


def cmd_setup(argv):
    pos, kv = opts(argv, set(["print-mcp", "print-rules"]))
    if kv.get("help") or kv.get("h"):
        print(SETUP_USAGE % ", ".join(r["name"] for r in harnesses()))
        return
    for k in kv:
        if k not in SETUP_FLAGS:
            die("setup does not take --%s" % k, 2, "flags: --harness NAME --print-mcp --print-rules")
    me = shutil.which("talos") or os.path.abspath(__file__)
    if kv.get("print-mcp"):
        print(json.dumps({"mcpServers": {MANAGED: mcp_entry({}, me)}}, indent=2))
        return
    if kv.get("print-rules"):
        print(skill_text()[0].rstrip())
        return
    if kv.get("harness"):
        rows = [r for r in harnesses() if r["name"] == kv["harness"]]
        if not rows:
            die("no harness %s" % kv["harness"], 2,
                "one of " + ", ".join(r["name"] for r in harnesses()))
    else:
        rows = live_harnesses()
    refresh_skill(rows)
    for row in rows:
        say(row["name"], "mcp", register_mcp(row, me))
    missing = [r["name"] for r in harnesses() if not detected(r)] if not kv.get("harness") else []
    if missing:
        note("not installed, skipped: %s (talos setup --harness <name> writes one anyway)"
             % ", ".join(missing))


def open_or_empty(path):
    try:
        with open(path) as fh:
            return fh.read()
    except (IOError, OSError):
        return ""


def check(label, ok, detail, fix):
    print("%s %-18s %s" % ("ok  " if ok else "FAIL", label, detail if ok else detail + "  ->  " + fix))
    return bool(ok)


def cmd_doctor(argv):
    url = resolve_url(refresh=True)
    c = load_config()
    tok = os.environ.get("TALOS_TOKEN") or c.get("token")
    good = check("config file", os.path.isfile(CONFIG), CONFIG, "talos login")
    good &= check("desk url", bool(url), url or "unset", "talos login --url <desk url>")
    good &= check("token", bool(tok), "present" if tok else "missing", "talos login")
    health, minv = None, None
    if url:
        try:
            r = urllib.request.urlopen(url.rstrip("/") + "/health", timeout=15)
            health = json.loads(r.read().decode("utf-8", "replace"))
            minv = r.headers.get("X-Talos-Min-Client") or health.get("min_client")
        except Exception as e:
            note("talos: /health said %s" % e)
    good &= check("desk reachable", bool(health),
                  (url or "") + (" (desk %s)" % health["version"] if health else " no answer"),
                  "check the URL, or ask @SHAcollision whether the desk moved")
    who = None
    if url and tok:
        try:
            who = request("GET", "/me", timeout=20)
        except (Desk, SystemExit) as ex:
            note("talos: /me said %s" % ex)
    good &= check("token valid", bool(who), ("@" + who["handle"]) if who else "rejected",
                  "talos login")
    installed = [p for p in SKILL_PATHS if os.path.isfile(p)]
    good &= check("skill installed", bool(installed), ", ".join(installed) or "nowhere", "talos setup")
    for row in live_harnesses():
        sheet = row["sheet"]["path"]
        where = "sheet %s" % ("yes" if os.path.isfile(sheet) else "missing")
        state = registered_in(row)
        if state is None:
            print("ok   %-18s detected, it does not say whether talos is registered" % row["name"])
            continue
        good &= check(row["name"], state and os.path.isfile(sheet),
                      "mcp registered, " + where, "talos setup --harness " + row["name"])
    current = not (minv and version_tuple(minv) > version_tuple(VERSION))
    good &= check("client version", current, VERSION if current else VERSION + ", desk wants " + minv,
                  "curl -fsSL https://raw.githubusercontent.com/pubky/talos-cli/main/install.sh | sh")
    sys.exit(0 if good else 1)


# ---------- MCP over stdio: every request goes to the desk's /mcp as is ----------

MCP_MAX = 8 * 1024 * 1024


def cmd_mcp(argv):
    c = load_config()
    tok = os.environ.get("TALOS_TOKEN") or c.get("token")
    url = resolve_url() if tok else ""
    out = sys.stdout
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        mid = msg.get("id")
        if not url or not tok:
            if mid is not None:
                out.write(json.dumps({"jsonrpc": "2.0", "id": mid, "error": {
                    "code": -32000, "message": "talos is not logged in: run `talos login` in a terminal"}}) + "\n")
                out.flush()
            continue
        req = urllib.request.Request(url.rstrip("/") + "/mcp", data=json.dumps(msg).encode(),
                                     headers={"Authorization": "Bearer " + tok,
                                              "Content-Type": "application/json",
                                              "User-Agent": "talos-cli/" + VERSION})
        try:
            r = urllib.request.urlopen(req, timeout=20 * 60)
            payload = r.read(MCP_MAX).decode("utf-8", "replace")
            if r.getcode() == 202 or mid is None:
                continue
            # one request, one reply: a body carrying a second frame would reach the agent as the
            # answer to something it never asked
            try:
                reply = json.loads(payload)
            except ValueError:
                reply = None
            if not isinstance(reply, dict) or reply.get("id") != mid:
                reply = {"jsonrpc": "2.0", "id": mid, "error": {
                    "code": -32000, "message": "the desk did not answer this request"}}
            out.write(json.dumps(reply) + "\n")
            out.flush()
        except urllib.error.HTTPError as e:
            try:
                err = json.loads(e.read().decode("utf-8", "replace")).get("error", str(e.reason))
            except ValueError:
                err = str(e.reason)
            if mid is not None:
                out.write(json.dumps({"jsonrpc": "2.0", "id": mid, "error": {
                    "code": -32000, "message": "desk %s: %s" % (e.code, err)}}) + "\n")
                out.flush()
        except urllib.error.URLError as e:
            if mid is not None:
                out.write(json.dumps({"jsonrpc": "2.0", "id": mid, "error": {
                    "code": -32000, "message": "cannot reach the desk: %s" % e.reason}}) + "\n")
                out.flush()


# ---------- entry ----------

PLAIN = {"login": cmd_login, "whoami": cmd_whoami, "doctor": cmd_doctor, "setup": cmd_setup,
         "mcp": cmd_mcp, "verbs": cmd_verbs, "skill": cmd_skill}


def main(argv):
    global QUIET
    if "--quiet" in argv:
        QUIET = True
        argv = [a for a in argv if a != "--quiet"]
    if "--url" in argv:
        i = argv.index("--url")
        if i + 1 >= len(argv):
            die("--url needs a value", 2)
        os.environ["TALOS_URL"] = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    if not argv:
        usage_all()
        return
    if argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if argv[0] in ("-V", "--version", "version"):
        print("talos " + VERSION)
        return
    if argv[0] == "help":
        if len(argv) == 1:
            return usage_all()
        v, _ = match_verb(argv[1:])
        if not v:
            die("no verb %s" % " ".join(argv[1:]), 2, "`talos` lists them all")
        return help_verb(v)
    if argv[0] in PLAIN:
        return PLAIN[argv[0]](argv[1:])
    v, rest = match_verb(argv)
    if not v:
        die("unknown command %s" % argv[0], 2, "`talos` lists every verb")
    cmd_verb(v, rest)


SKILL_MD = r'''# Talos from the terminal

This page is a snapshot of the sheet the desk serves; `talos setup` and
`talos login` replace it with the live one.

Rule of thumb: `talos find` first, it is free and instant. Then `talos skills` for what the team already wrote down. `talos ask` only when the answer needs Talos's own memory or judgement, and `talos delegate` when the job takes minutes and you do not want to wait.

Not logged in? Run `talos login`, open the GitHub device prompt it prints and enter the code. The desk checks you are in the pubky org and gives you a token of its own; logging in again rotates that token and the old one stops working. Someone outside the org uses `talos login <token>` with a token from @SHAcollision.

## Read verbs: free, seconds, no model

`talos find "<words>" [--in slack,meet,drive,github,code,pubky] [--days N] [--from who] [--limit N]`

Search Slack, Meet transcripts, Drive, GitHub and pubky.app at once. Use it for any lookup: where did we discuss X, did anyone report Y, who owns Z, what did the call conclude.

```
talos find "nexus watcher lag" --days 90
```

`talos open <slack link | C0123ABC:1712345678.123456>`

The whole Slack thread behind a link, in order, full text. Use it after a find hit whose snippet is not enough.

```
talos open https://synonym.slack.com/archives/C0BUJLZCWNB/p1712345678123456
```

`talos skill`

The capability sheet the desk serves, as markdown. Use it to refresh what the desk can do without asking Talos.

```
talos skill
```

`talos skills [<name>]`

List the knowledge skills you can read, or print one. Use it before asking Talos something the team already wrote down.

```
talos skills pubky-architecture
```

`talos whosout [--weeks N]`

Who is on holiday, from the team calendars. Use it before booking a call or assigning work.

```
talos whosout --weeks 4
```

`talos status`

Talos's own health: units, heartbeats, budgets, crons. Use it when Talos looks stuck or a scheduled job did not run.

```
talos status
```

`talos who <name | github login | slack id>`

A teammate's team, GitHub login and Slack id. Use it to turn a name into a GitHub login before mentioning them.

```
talos who ben
```

`talos inbox [--all] [--limit N]`

What you asked the desk for lately and how it went. Use it to find a run id, a filed issue or a doc link again.

```
talos inbox --limit 5
```

`talos review status <pr-url | owner/repo#num>`

Whether Talos is a requested reviewer, whether he reviewed, and if not why. Use it after `talos review` when no review showed up.

```
talos review status pubky/pubky-nexus#123
```

`talos jobs`

Your delegated runs and their state. Use it to see what you started and whether it finished.

```
talos jobs
```

`talos result <run-id> [--wait]`

The output of a delegated run. Use it when `talos jobs` says a run completed, or to block until it does.

```
talos result 8f2c1a --wait
```

`talos stop <run-id>`

Stop a delegated run you started. Use it when you delegated the wrong thing.

```
talos stop 8f2c1a
```

`talos doc read <docId>`

A Google Doc back as markdown. Use it to quote or diff a doc Talos wrote.

```
talos doc read 1AbC_defGH
```

`talos meet list`

Calls Talos has on record and their state. Use it to find an event id or check a booking went through.

```
talos meet list
```

## Write verbs: they change something, so they need --yes

`talos review <pr-url | owner/repo#num> [--yes]`

Ask Talos to review a PR; the review lands on GitHub within minutes. Use it right after opening a PR in a pubky repo.

```
talos review pubky/pubky-nexus#123 --yes
```

`talos issue <owner/repo> "<title>" [--body text | --body-file f] [--from <slack link>] [--label l] [--force] [--yes]`

File a GitHub issue in a pubky or synonymdev repo, signed with your handle. Use it when a Slack thread or a find hit turned into real work.

```
talos issue pubky/pubky-nexus "watcher lag after restart" --body-file bug.md --yes
```

`talos doc create --title "<title>" (--md <file> | stdin) [--share synonym.to | a@x,b@y] [--yes]`

Turn markdown into a formatted Google Doc and share it. Use it for anything longer than a Slack message that the team should keep.

```
talos doc create --title "Nexus watcher postmortem" --md postmortem.md --yes
```

`talos meet book --title T --start LOCAL --end LOCAL --tz Zone --with "Name,Name" [--yes]`

Book a Google Meet call and bring the summary back to Slack. Use it when a thread needs a call; the preview warns if someone is on holiday.

```
talos meet book --title "nexus sync" --start 2026-09-20T14:00 --end 2026-09-20T14:30 --tz Europe/Berlin --with "Ben Kaufman,tomos" --yes
```

`talos remember "<fact>" [--yes]`

Add one durable fact to Talos's environment skill, as a PR a human merges. Use it when Talos got something wrong that will come up again.

```
talos remember "the canonical nexus checkout is ~/pubky/pubky-nexus" --yes
```

## Agent verbs: a real Talos turn, budgeted

`talos ask "<question>" [--thread name] [--skill name]`

One Talos turn: his memory, his tools, his judgement. Use it only when find and the knowledge skills cannot answer it.

```
talos ask "why did settings leave the pubky-app spec, and who decided?"
```

`talos delegate "<task>" [--key K] [--skill name]`

Hand Talos a long job and get a run id back at once. Use it for work that takes minutes: a sweep, a comparison, a report.

```
talos delegate "compare the nexus watcher lag before and after #123" --key lag-1
```

## Knowledge you can read

`talos skills` lists them, `talos skills <name>` prints one. Read one before asking Talos.

- `pubky-architecture`: How pkarr, homeserver, nexus and pubky-app fit together.
- `pubky-nexus-codebase`: Internals of the pubky-nexus server code.
- `pubky-nexus-test-suite`: Run the pubky-nexus test suites and Docker stack.
- `pubky-passport`: Work on pubky/passport: onboarding, /authorize, Homegate.
- `pubky-vibes`: Work on pubky/vibes, vibe PRs and vibe SSO.
- `synonym-website`: Edit synonym.to content: team cards, keys, links.
- `pubky-feedback-triage`: Triage pubky-feedback posts into pubky-app issues.
- `ci-performance`: Evaluate and pilot CI speedups against real numbers.
- `talos-docs`: Google Docs written from Markdown with talos-doc, formatted properly every time.
- `talos-meet-scheduling`: Book Meet calls for teammates; summaries come back alone.
- `talos-whosout`: Who is on time off, from the calendar events HiBob writes.
- `pr-review`: Review a PR with at most six verified inline findings.
- `talos-find`: One search across Slack, Drive, transcripts, GitHub, pubky.
- `stacked-pull-requests`: Use when reviewing or extending stacked PR chains.
- `flaky-test-triage`: Use when CI is green yet a test failed earlier, or flakes.

## Don'ts

- Never paste secrets, tokens or private keys into an ask or a delegate.
- One ask per question. On `over budget` (exit 3) stop and tell the user.
- Quote the link of any hit you use; do not paraphrase a thread from memory.
- Write verbs do nothing without `--yes`. Read the preview before passing it.
- The desk does not move or cancel other people's calls, and files issues in pubky and synonymdev only.

Exit codes: 0 ok, 1 error, 2 usage, 3 over budget, 4 not logged in, 5 needs --yes, 6 not found, 7 refused by a Talos rule.
'''

if __name__ == "__main__":
    main(sys.argv[1:])
