# Exit codes by HTTP status. The desk picks the status, so the two stay in step.
EXIT = {400: 2, 401: 4, 403: 4, 404: 6, 409: 7, 429: 3}
# v0.1 routes, so a v0.2 client keeps working against a desk that has not been deployed yet.
LEGACY = {"find": "/find", "ask": "/ask", "review": "/review"}

